---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { buildPostPaths } from '../../lib/post-paths';
import { getPublishedPosts, sortPosts, type BlogPost } from '../../lib/posts';

interface Props {
  post: BlogPost;
  newer: BlogPost | null;
  older: BlogPost | null;
}

export async function getStaticPaths() {
  // Only direct article routes expose drafts during local development.
  // Production routes, feeds, and discovery pages keep using published content.
  const posts = import.meta.env.DEV
    ? sortPosts(await getCollection('blog'))
    : await getPublishedPosts();
  return buildPostPaths(posts);
}

const { post, newer, older }: Props = Astro.props;
const { Content, headings } = await render(post);
---

<PostLayout post={post} headings={headings} newer={newer} older={older}><Content /></PostLayout>
