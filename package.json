{
  "name": "parzival-the-goat-blog",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:site": "astro build",
    "build:search": "pagefind --site dist && node scripts/remove-pagefind-ui-css.mjs",
    "validate:design": "node scripts/validate-design.mjs",
    "notion": "node tools/notion/sync.mjs",
    "build": "pnpm run build:site && pnpm run build:search && pnpm run validate:design",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "verify": "pnpm run check && pnpm run test && pnpm run build && pnpm run test:e2e"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "astro": "^6.4.8",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "pagefind": "^1.5.2",
    "sharp": "0.34.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
