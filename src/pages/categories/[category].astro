---
import PostList from '../../components/PostList.astro';
import StudyHead from '../../components/StudyHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTaxonomyCounts, getTrackNumbers } from '../../lib/posts';

// Only categories that already hold a post get a page.
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getTaxonomyCounts(posts).categories.map(({ name }) => ({ params: { category: name } }));
}

const category = Astro.params.category ?? '';
const all = await getPublishedPosts();
const posts = all.filter((post) => post.data.category === category);
---

<BaseLayout title={category}>
  <StudyHead title={category} count={posts.length} />
  <PostList posts={posts} numbers={getTrackNumbers(all)} />
</BaseLayout>
