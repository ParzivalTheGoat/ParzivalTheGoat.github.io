<form class="search-form" role="search">
  <label for="query">搜索文章</label>
  <input id="query" name="query" type="search" autocomplete="off" />
  <button type="submit">搜索</button>
</form>
<p class="search-status" aria-live="polite"></p>
<ol class="search-results"></ol>

<script>
  const form = document.querySelector<HTMLFormElement>('.search-form');
  const input = document.querySelector<HTMLInputElement>('#query');
  const status = document.querySelector<HTMLElement>('.search-status');
  const list = document.querySelector<HTMLOListElement>('.search-results');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  let generation = 0;

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!input || !status || !list || !button) return;

    const request = ++generation;
    const query = input.value.trim();
    list.replaceChildren();
    status.textContent = '正在搜索';
    form.setAttribute('aria-busy', 'true');

    try {
      const pagefindPath = '/pagefind/' + 'pagefind.js';
      const pagefind = await import(pagefindPath) as typeof import('/pagefind/pagefind.js');
      const search = await pagefind.search(query);
      const results = document.createDocumentFragment();

      for (const result of search.results) {
        const data = await result.data();
        if (request !== generation) return;
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = data.url;
        link.textContent = data.meta.title;
        item.append(link);
        results.append(item);
      }

      if (request !== generation) return;
      list.replaceChildren(results);
      status.textContent = search.results.length === 0 ? '没有找到匹配内容' : `${search.results.length} 条结果`;
    } catch {
      if (request !== generation) return;
      list.replaceChildren();
      status.textContent = '搜索暂时不可用';
    } finally {
      if (request !== generation) return;
      form.setAttribute('aria-busy', 'false');
    }
  });
</script>
