---
import { formatMonth } from '../lib/posts';
import Brand from './Brand.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  masthead?: boolean;
}

const { masthead = false } = Astro.props;
const links = [
  { href: '/', label: '首页', match: (path: string) => path === '/' },
  { href: '/posts/', label: '学习', match: (path: string) => ['/posts/', '/categories/', '/tags/', '/archive/'].some((prefix) => path.startsWith(prefix)) },
  { href: '/about/', label: '关于', match: (path: string) => path.startsWith('/about/') },
  { href: '/search/', label: '搜索', match: (path: string) => path.startsWith('/search/') },
];
const path = Astro.url.pathname;
---

<header class:list={['site-header', 'shell', { compact: !masthead }]}>
  {masthead && (
    <div class="masthead">
      <h1 class="mast-name">Parzival<span class="dot">.</span></h1>
      <p class="mast-date">{formatMonth(new Date())}</p>
      <a class="mast-jump" href="#side-b">B 面 · 放一张 ↓</a>
    </div>
  )}
  <div class="header-bar">
    {!masthead && <Brand />}
    <nav class="primary-nav" aria-label="主导航">
      <ul>
        {links.map((link) => <li><a href={link.href} aria-current={link.match(path) ? 'page' : undefined}>{link.label}</a></li>)}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>
