{
  "name": "parzival-the-goat-blog",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:site": "astro build",
    "build:search": "pagefind --site dist && node scripts/remove-pagefind-ui-css.mjs",
    "validate:design": "node scripts/validate-design.mjs",
    "notion": "node tools/notion/sync.mjs",
    "build": "pnpm run build:site && pnpm run build:search && pnpm run validate:design",
    "preview": "astro preview",
    "test:e2e": "playwright test",
    "verify": "pnpm run check && pnpm run test && pnpm run build && pnpm run test:e2e",
    "write": "node tools/writer/server.mjs"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "astro": "^6.4.8",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@playwright/test": "^1.62.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bubble-menu": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "pagefind": "^1.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.5",
    "typescript": "^6.0.3",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
