---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
---

{headings.length > 0 && (
  <aside class="toc-region">
    <details open>
      <summary class="mono">目录</summary>
      <nav aria-label="文章目录">
        <ol>
          {headings.map((heading) => (
            <li class={`toc-depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    </details>
  </aside>
)}

<script>
  const details = document.querySelector<HTMLDetailsElement>('.toc-region details');
  const desktop = matchMedia('(min-width: 70rem)');
  const syncDirectory = () => { if (details) details.open = desktop.matches; };
  syncDirectory();
  desktop.addEventListener('change', syncDirectory);
</script>
