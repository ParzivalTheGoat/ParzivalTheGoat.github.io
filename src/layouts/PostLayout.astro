---
import PostMeta from '../components/PostMeta.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { getPostHref, getPublishedPosts, getReadingMinutes, getTrackNumbers, LONG_POST_MINUTES, type BlogPost } from '../lib/posts';
import '../styles/prose.css';
import BaseLayout from './BaseLayout.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  post: BlogPost;
  headings: Heading[];
  newer: BlogPost | null;
  older: BlogPost | null;
}

const { post, headings, newer, older } = Astro.props;
const isPreview = post.data.draft || post.data.publishedAt > new Date();
const numbers = getTrackNumbers(await getPublishedPosts());
const trackLabel = (entry: BlogPost) => {
  const number = numbers.get(entry.id);
  return number ? `A${number}` : '';
};
const isLong = getReadingMinutes(post.body ?? '') >= LONG_POST_MINUTES;
---

<BaseLayout title={post.data.title} description={post.data.description} noindex={isPreview}>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>
  <div class="post-sheet">
    <div class="post-aside">
      {trackLabel(post) && <span class="sheet-mark" aria-hidden="true">{trackLabel(post)}</span>}
      <PostMeta post={post} />
      <div class="np" data-now-playing><a href="/#side-b">放一张 →</a></div>
      <TableOfContents headings={headings} />
    </div>
    <div class="post-main">
      <header class="post-header">
        {isPreview && <p class="draft-notice" role="note">本地草稿预览 · 尚未发布</p>}
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
      </header>
      <article class:list={['prose', { 'has-dropcap': isLong }]} data-pagefind-body>
        <slot />
      </article>
      {(newer || older) && (
        <nav class="post-navigation" aria-label="文章导航">
          {older && <a href={getPostHref(older.id)}><span class="nav-label">较早 {trackLabel(older)}</span><span>{older.data.title}</span></a>}
          {newer && <a href={getPostHref(newer.id)}><span class="nav-label">较新 {trackLabel(newer)}</span><span>{newer.data.title}</span></a>}
        </nav>
      )}
    </div>
  </div>
</BaseLayout>

<script>
  import { createCopyFeedback } from '../lib/copy-feedback';

  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');

  function updateProgress() {
    if (!progress) return;
    const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
    const percentage = scrollableHeight > 0 ? (window.scrollY / scrollableHeight) * 100 : 0;
    progress.style.width = `${Math.min(100, Math.max(0, percentage))}%`;
  }

  updateProgress();
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  new ResizeObserver(updateProgress).observe(document.body);

  document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'table-scroll';
    wrapper.tabIndex = 0;
    wrapper.setAttribute('role', 'region');
    wrapper.setAttribute('aria-label', '表格，可横向滚动');
    table.before(wrapper);
    wrapper.append(table);
  });

  if (navigator.clipboard) {
    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      const source = pre.querySelector('code')?.textContent ?? pre.textContent ?? '';
      const button = document.createElement('button');
      button.className = 'copy-code';
      button.type = 'button';
      button.textContent = '复制';
      const copy = createCopyFeedback(button, navigator.clipboard);
      button.addEventListener('click', () => { void copy(source); });
      pre.append(button);
    });
  }
</script>
