---
import PostList from '../../components/PostList.astro';
import StudyHead from '../../components/StudyHead.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTaxonomyCounts, getTrackNumbers } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getTaxonomyCounts(posts).tags.map(({ name }) => ({ params: { tag: name } }));
}

const tag = Astro.params.tag ?? '';
const all = await getPublishedPosts();
const posts = all.filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={tag}>
  <StudyHead title={`#${tag}`} count={posts.length} />
  <PostList posts={posts} numbers={getTrackNumbers(all)} />
</BaseLayout>
