---
import PostList from '../components/PostList.astro';
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
---

<BaseLayout>
  <h1>Parzival's Lab</h1>
  <div class="hero-actions">
    <a class="ui-button ui-button-primary" href="/posts/">浏览文章<Icon name="arrow" /></a>
    <a class="ui-button" href="/categories/"><Icon name="categories" />探索分类</a>
  </div>
  <section class="home-latest" aria-labelledby="latest">
    <div class="section-heading"><h2 id="latest">最新文章</h2><a class="ui-button" href="/archive/">文章归档<Icon name="arrow" /></a></div>
    <PostList posts={posts.slice(0, 10)} />
  </section>
</BaseLayout>
