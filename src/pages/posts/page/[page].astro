---
import Pagination from '../../../components/Pagination.astro';
import PostList from '../../../components/PostList.astro';
import { SITE } from '../../../config/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts, paginatePosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const { totalPages } = paginatePosts(posts, 1, SITE.postsPerPage);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const posts = await getPublishedPosts();
const pagination = paginatePosts(posts, Number(Astro.params.page), SITE.postsPerPage);
---

<BaseLayout title={`文章 · 第 ${pagination.currentPage} 页`}>
  <h1>文章</h1>
  <PostList posts={pagination.items} />
  <Pagination currentPage={pagination.currentPage} totalPages={pagination.totalPages} />
</BaseLayout>
