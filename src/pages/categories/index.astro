---
import StudyHead from '../../components/StudyHead.astro';
import { CATEGORIES } from '../../content/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTaxonomyCounts } from '../../lib/posts';

const posts = await getPublishedPosts();
const counts = new Map(getTaxonomyCounts(posts).categories.map(({ name, count }) => [name, count]));
const categories = CATEGORIES.filter((category) => counts.has(category));
---

<BaseLayout title="分类">
  <StudyHead title="分类" />
  {categories.length === 0 ? (
    <p class="empty-state">暂无文章</p>
  ) : (
    <ul class="taxonomy-list">
      {categories.map((category) => (
        <li data-category-row>
          <a href={`/categories/${category}/`}>{category}<span class="count">{counts.get(category)} 篇</span></a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
