---
import { formatDotDate, getReadingMinutes, getTagHref, type BlogPost } from '../lib/posts';

interface Props {
  post: BlogPost;
  includeTags?: boolean;
}

const { post, includeTags = true } = Astro.props;
const linkTags = !post.data.draft && post.data.publishedAt <= new Date();
const publishedAt = post.data.publishedAt.toISOString();
const updatedAt = post.data.updatedAt?.toISOString();
---

<ul class="post-facts">
  <li>{linkTags ? <a href={`/categories/${post.data.category}/`}>{post.data.category}</a> : post.data.category}</li>
  {post.data.project && <li>{post.data.project}</li>}
  <li><time datetime={publishedAt}>{formatDotDate(post.data.publishedAt)}</time></li>
  {updatedAt && post.data.updatedAt && <li>更新于 <time datetime={updatedAt}>{formatDotDate(post.data.updatedAt)}</time></li>}
  <li>阅读约 {getReadingMinutes(post.body ?? '')} 分钟</li>
  {includeTags && post.data.tags.length > 0 && (
    <li class="post-tags">
      {post.data.tags.map((tag) => linkTags ? <a href={getTagHref(tag)}>#{tag}</a> : <span>#{tag}</span>)}
    </li>
  )}
</ul>
